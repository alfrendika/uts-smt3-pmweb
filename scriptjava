// Helper umum
const $ = (s, r = document) => r.querySelector(s);
const rp = n => "Rp" + Number(n).toLocaleString("id-ID");
const esc = s => String(s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
const load = (k, d) => { try { return JSON.parse(localStorage.getItem(k)) || d; } catch { return d; } };
const save = (k, v) => localStorage.setItem(k, JSON.stringify(v));
const semuaTransaksi = () => [...dataTransaksi, ...load("transaksi", [])];
const katalog = () => load("katalog", dataKatalogBuku.map(b => ({ ...b })));
const page = document.body.dataset.page;

function openModal(id) { $("#" + id).classList.add("show"); }
function showMsg(judul, isi) { $("#msgTitle").textContent = judul; $("#msgBody").innerHTML = isi; openModal("msgModal"); }
document.addEventListener("click", e => {
  const t = e.target;
  if (t.dataset.open) openModal(t.dataset.open);
  if (t.hasAttribute("data-close") || t.classList.contains("modal")) t.closest(".modal").classList.remove("show");
});

// Guard login + logout
if (page !== "login" && !load("user", null)) location.href = "index.html";
const btnLogout = $("#btnLogout");
if (btnLogout) btnLogout.onclick = () => { localStorage.removeItem("user"); location.href = "index.html"; };

function initLogin() {
  const users = () => load("users", dataPengguna);
  $("#formLogin").addEventListener("submit", e => {
    e.preventDefault();
    const em = $("#email").value.trim().toLowerCase(), pw = $("#password").value;
    const u = users().find(x => x.email.toLowerCase() === em && x.password === pw);
    if (!u) return alert("Email/password yang anda masukkan salah");
    save("user", u); location.href = "dashboard.html";
  });
  $("#formLupa").addEventListener("submit", e => {
    e.preventDefault();
    const em = $("#emailLupa").value.trim().toLowerCase();
    if (!users().some(x => x.email.toLowerCase() === em)) return alert("Email belum terdaftar.");
    $("#modalLupa").classList.remove("show");
    alert("Link reset password telah dikirim ke " + em + " (simulasi).");
  });
  $("#formDaftar").addEventListener("submit", e => {
    e.preventDefault();
    const nama = $("#dNama").value.trim(), em = $("#dEmail").value.trim(), pw = $("#dPass").value;
    if (nama.length < 3) return alert("Nama minimal 3 karakter.");
    if (!/^\S+@\S+\.\S+$/.test(em)) return alert("Format email tidak valid.");
    if (pw.length < 6) return alert("Password minimal 6 karakter.");
    const list = users();
    if (list.some(x => x.email.toLowerCase() === em.toLowerCase())) return alert("Email sudah terdaftar.");
    list.push({ nama, email: em, password: pw }); save("users", list);
    $("#modalDaftar").classList.remove("show"); e.target.reset();
    alert("Pendaftaran berhasil! Silakan login.");
  });
}

function initDashboard() {
  const h = new Date().getHours();
  const w = h < 11 ? "Pagi" : h < 15 ? "Siang" : h < 18 ? "Sore" : "Malam";
  $("#greeting").textContent = `Selamat ${w}, ${load("user", {}).nama}!`;
  const tick = () => $("#jam").textContent = new Date().toLocaleString("id-ID", { dateStyle: "full", timeStyle: "medium" });
  tick(); setInterval(tick, 1000);
}

function initStok() {
  const data = katalog(), tb = $("#tbStok tbody");
  const render = (q = "") => {
    tb.innerHTML = "";
    data.forEach((b, i) => {
      if (!(b.judul + b.kode).toLowerCase().includes(q.toLowerCase())) return;
      const tr = document.createElement("tr");
      tr.innerHTML = `<td><img src="${esc(b.cover)}" alt="Cover ${esc(b.judul)}" width="40"></td><td>${esc(b.kode)}</td><td>${esc(b.judul)}</td><td>${esc(b.kategori)}</td><td>${rp(b.harga)}</td><td class="${b.stok < 10 ? "low" : ""}">${b.stok}</td><td><button class="btn sm danger" data-i="${i}" type="button">Hapus</button></td>`;
      tb.appendChild(tr);
    });
    save("katalog", data);
  };
  render();
  $("#cari").addEventListener("input", e => render(e.target.value));
  tb.addEventListener("click", e => {
    const i = e.target.dataset.i;
    if (i !== undefined && confirm(`Hapus "${data[i].judul}" dari katalog?`)) { data.splice(i, 1); render($("#cari").value); }
  });
  $("#formStok").addEventListener("submit", e => {
    e.preventDefault();
    const b = { kode: $("#kode").value.trim().toUpperCase(), judul: $("#judul").value.trim(), kategori: $("#kategori").value.trim(), harga: +$("#harga").value, stok: +$("#stok").value, cover: "img/buku1.svg" };
    const err = [];
    if (!b.kode || !b.judul || !b.kategori) err.push("Kode, judul, dan kategori wajib diisi.");
    if (data.some(x => x.kode === b.kode)) err.push("Kode buku sudah ada.");
    if (!(b.harga > 0)) err.push("Harga harus lebih dari 0.");
    if ($("#stok").value === "" || b.stok < 0) err.push("Stok tidak boleh kosong/negatif.");
    $("#errStok").textContent = err.join(" ");
    if (err.length) return;
    data.push(b); render(); e.target.reset();
    showMsg("Berhasil", `Buku <b>${esc(b.judul)}</b> ditambahkan ke katalog.`);
  });
}

function initCheckout() {
  let kat = katalog(), cart = load("cart", []);
  $("#selBuku").innerHTML = kat.map(b => `<option value="${esc(b.kode)}">${esc(b.judul)} - ${rp(b.harga)} (stok ${b.stok})</option>`).join("");
  const tb = $("#tbCart tbody");
  const render = () => {
    tb.innerHTML = cart.map((c, i) => `<tr><td>${esc(c.judul)}</td><td>${rp(c.harga)}</td><td><input type="number" class="qty" min="1" value="${c.qty}" data-q="${i}"></td><td>${rp(c.harga * c.qty)}</td><td><button class="btn sm danger" data-d="${i}" type="button">Hapus</button></td></tr>`).join("") || '<tr><td colspan="5">Belum ada buku dipilih.</td></tr>';
    $("#total").textContent = rp(cart.reduce((s, c) => s + c.harga * c.qty, 0));
    save("cart", cart);
  };
  render();
  $("#btnTambah").onclick = () => {
    const b = kat.find(x => x.kode === $("#selBuku").value); if (!b) return;
    const ada = cart.find(c => c.kode === b.kode);
    ada ? ada.qty++ : cart.push({ kode: b.kode, judul: b.judul, harga: b.harga, qty: 1 });
    render();
  };
  tb.addEventListener("change", e => { if (e.target.dataset.q) { cart[e.target.dataset.q].qty = Math.max(1, parseInt(e.target.value) || 1); render(); } });
  tb.addEventListener("click", e => { if (e.target.dataset.d) { cart.splice(e.target.dataset.d, 1); render(); } });
  $("#formCo").addEventListener("submit", e => {
    e.preventDefault();
    const f = id => $("#" + id).value.trim(), err = [];
    document.querySelectorAll("#formCo input,#formCo textarea,#formCo select").forEach(x => x.classList.remove("invalid"));
    const cek = (ok, id, msg) => { if (!ok) { err.push(msg); $("#" + id).classList.add("invalid"); } };
    cek(f("nama").length >= 3, "nama", "Nama minimal 3 karakter.");
    cek(/^\S+@\S+\.\S+$/.test(f("emailCo")), "emailCo", "Format email tidak valid.");
    cek(/^08\d{8,11}$/.test(f("telp")), "telp", "No. telepon harus diawali 08 (10-13 digit).");
    cek(f("alamat").length >= 10, "alamat", "Alamat minimal 10 karakter.");
    cek(f("metode") !== "", "metode", "Pilih metode pembayaran.");
    if (!cart.length) err.push("Pesanan masih kosong.");
    cart.forEach(c => { const b = kat.find(x => x.kode === c.kode); if (b && c.qty > b.stok) err.push(`Stok "${c.judul}" hanya ${b.stok}.`); });
    $("#errCo").innerHTML = err.map(x => `<li>${esc(x)}</li>`).join("");
    if (err.length) return alert("Pesanan gagal:\n- " + err.join("\n- "));
    const noDO = "DO" + Date.now().toString().slice(-7);
    const total = cart.reduce((s, c) => s + c.harga * c.qty, 0);
    const trx = load("transaksi", []);
    trx.push({ do: noDO, nama: f("nama"), tanggal: new Date().toISOString().slice(0, 10), metode: f("metode"), ekspedisi: f("ekspedisi"), paket: f("paket"), status: 0, total, items: cart.map(c => ({ judul: c.judul, harga: c.harga, qty: c.qty })) });
    save("transaksi", trx);
    cart.forEach(c => { const b = kat.find(x => x.kode === c.kode); if (b) b.stok -= c.qty; });
    save("katalog", kat);
    showMsg("Pesanan Berhasil", `Terima kasih, <b>${esc(f("nama"))}</b>!<br>Nomor DO: <b>${noDO}</b><br>Total: <b>${rp(total)}</b>`);
    cart = []; render(); e.target.reset();
    kat = katalog(); $("#selBuku").innerHTML = kat.map(b => `<option value="${esc(b.kode)}">${esc(b.judul)} - ${rp(b.harga)} (stok ${b.stok})</option>`).join("");
  });
}

function initTracking() {
  $("#formTrack").addEventListener("submit", e => {
    e.preventDefault();
    const no = $("#noDO").value.trim().toUpperCase(), out = $("#hasil");
    if (!no) return showMsg("Peringatan", "Nomor Delivery Order wajib diisi.");
    const d = semuaTransaksi().find(t => t.do === no);
    if (!d) { out.innerHTML = `<p class="error">Nomor DO <b>${esc(no)}</b> tidak ditemukan.</p>`; return; }
    const pct = d.status / (statusPengiriman.length - 1) * 100;
    out.innerHTML = `<h2>${esc(d.nama)} <span class="badge">${statusPengiriman[d.status]}</span></h2>
      <div class="bar" role="progressbar" aria-valuenow="${pct}" aria-valuemin="0" aria-valuemax="100"><div style="width:0" data-w="${pct}"></div></div>
      <ol class="steps">${statusPengiriman.map((s, i) => `<li class="${i <= d.status ? "done" : ""}">${i <= d.status ? "✔" : "○"}<br>${s}</li>`).join("")}</ol>
      <table><tr><th>Ekspedisi</th><td>${esc(d.ekspedisi)}</td></tr><tr><th>Tanggal kirim</th><td>${esc(d.tanggal)}</td></tr><tr><th>Jenis paket</th><td>${esc(d.paket)}</td></tr><tr><th>Total pembayaran</th><td>${rp(d.total)}</td></tr></table>`;
    setTimeout(() => { const b = out.querySelector(".bar div"); b.style.width = b.dataset.w + "%"; }, 50);
  });
}

function initLaporan() {
  const all = semuaTransaksi(), per = {};
  all.forEach(t => t.items.forEach(i => { per[i.judul] = per[i.judul] || { q: 0, r: 0 }; per[i.judul].q += i.qty; per[i.judul].r += i.qty * i.harga; }));
  const omzet = all.reduce((s, t) => s + t.total, 0);
  $("#ringkasan").innerHTML = [["Total Pesanan", all.length], ["Total Pendapatan", rp(omzet)], ["Buku Terjual", Object.values(per).reduce((s, x) => s + x.q, 0)]].map(([k, v]) => `<div class="stat">${k}<strong>${v}</strong></div>`).join("");
  $("#tbLaporan tbody").innerHTML = Object.entries(per).sort((a, b) => b[1].q - a[1].q).map(([j, x]) => `<tr><td>${esc(j)}</td><td>${x.q}</td><td>${rp(x.r)}</td></tr>`).join("");
}

function initHistory() {
  $("#tbHistory tbody").innerHTML = semuaTransaksi().slice().reverse().map(t => `<tr><td>${esc(t.do)}</td><td>${esc(t.tanggal)}</td><td>${esc(t.nama)}</td><td>${esc(t.metode)}</td><td><span class="badge">${statusPengiriman[t.status]}</span></td><td>${rp(t.total)}</td></tr>`).join("");
}

({ login: initLogin, dashboard: initDashboard, stok: initStok, checkout: initCheckout, tracking: initTracking, laporan: initLaporan, history: initHistory })[page]?.();
