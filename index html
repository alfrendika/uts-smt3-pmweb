<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login | BukuKu</title>
<link rel="stylesheet" href="css/style.css">
</head>
<body data-page="login">
<header class="topbar"><a class="brand" href="dashboard.html"><img src="assets/logo.svg" alt="Logo BukuKu" width="32" height="32"> BukuKu</a></header>
<main class="container">
<section class="card auth">
<h1>Selamat Datang di BukuKu</h1>
<p class="muted">Masuk untuk memesan buku. Demo: admin@bukuku.com / admin123</p>
<form id="formLogin" novalidate>
<label for="email">Email</label><input type="email" id="email" placeholder="nama@email.com" required>
<label for="password">Password</label><input type="password" id="password" placeholder="Password" required>
<button class="btn block" type="submit">Login</button>
</form>
<div class="row center"><button class="btn link" data-open="modalLupa" type="button">Lupa Password</button><button class="btn link" data-open="modalDaftar" type="button">Daftar</button></div>
</section>
</main>
<footer class="footer"><p>&copy; 2026 BukuKu - Tugas UTS Pemrograman Web 1</p></footer>
<div class="modal" id="modalLupa"><div class="modal-box"><h2>Lupa Password</h2>
<form id="formLupa" novalidate><label for="emailLupa">Email terdaftar</label><input type="email" id="emailLupa" required><div class="row"><button class="btn" type="submit">Kirim Link Reset</button><button class="btn ghost" data-close type="button">Batal</button></div></form></div></div>
<div class="modal" id="modalDaftar"><div class="modal-box"><h2>Daftar Akun</h2>
<form id="formDaftar" novalidate><label for="dNama">Nama lengkap</label><input id="dNama" required><label for="dEmail">Email</label><input type="email" id="dEmail" required><label for="dPass">Password (min. 6 karakter)</label><input type="password" id="dPass" required><div class="row"><button class="btn" type="submit">Daftar</button><button class="btn ghost" data-close type="button">Batal</button></div></form></div></div>
<div class="modal" id="msgModal" role="dialog" aria-modal="true" aria-labelledby="msgTitle"><div class="modal-box"><h2 id="msgTitle"></h2><div id="msgBody"></div><button class="btn" data-close type="button">Tutup</button></div></div>
<script src="js/data.js"></script>
<script src="js/script.js"></script>
</body>
</html>
