*{box-sizing:border-box}
:root{--p:#2563eb;--bg:#f1f5f9;--t:#0f172a;--m:#64748b;--b:#e2e8f0}
body{margin:0;font-family:Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--t);min-height:100vh;display:flex;flex-direction:column}
.topbar{background:#fff;border-bottom:1px solid var(--b);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px;padding:10px 20px;position:sticky;top:0;z-index:5}
.brand{font-weight:700;font-size:1.2rem;color:var(--p);text-decoration:none;display:flex;align-items:center;gap:8px}
nav{display:flex;flex-wrap:wrap;gap:4px;align-items:center}
nav a{padding:6px 12px;border-radius:6px;color:var(--t);text-decoration:none;font-size:.9rem}
nav a:hover,nav a.aktif{background:var(--p);color:#fff}
.container{flex:1;width:100%;max-width:1000px;margin:20px auto;padding:0 16px}
.card{background:#fff;border-radius:12px;padding:20px;margin-bottom:16px;box-shadow:0 1px 4px rgba(0,0,0,.08)}
.auth{max-width:400px;margin:40px auto}
h1{margin-top:0}.muted{color:var(--m)}
label{display:block;margin:10px 0 4px;font-weight:600;font-size:.9rem}
input,select,textarea{width:100%;padding:9px 10px;border:1px solid #cbd5e1;border-radius:6px;font:inherit}
input:focus,select:focus,textarea:focus{outline:2px solid var(--p);border-color:var(--p)}
input.invalid{border-color:#dc2626}
.btn{background:var(--p);color:#fff;border:0;padding:9px 16px;border-radius:6px;cursor:pointer;font:inherit;margin-top:10px}
.btn:hover{opacity:.9}.btn.block{width:100%}.btn.sm{padding:5px 10px;margin:0;font-size:.85rem}
.btn.danger{background:#dc2626}.btn.ghost{background:#e2e8f0;color:var(--t)}.btn.link{background:none;color:var(--p);text-decoration:underline}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.row>select,.row>input{flex:1;min-width:180px}.center{justify-content:center}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
.menu-card{background:#fff;border-radius:12px;padding:20px;text-decoration:none;color:var(--t);box-shadow:0 1px 4px rgba(0,0,0,.08);transition:transform .2s}
.menu-card:hover{transform:translateY(-4px);box-shadow:0 6px 14px rgba(37,99,235,.2)}
.menu-card span{font-size:2rem}.menu-card h2{font-size:1.05rem;margin:8px 0 4px}.menu-card p{margin:0;color:var(--m);font-size:.9rem}
.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:4px 14px}.end{align-self:end}
.scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;margin-top:12px}
th,td{padding:9px 10px;border-bottom:1px solid var(--b);text-align:left;vertical-align:middle}
th{background:#f8fafc;font-size:.85rem}td img{border-radius:4px}.low{color:#dc2626;font-weight:700}
.qty{width:70px}.total{text-align:right;font-size:1.1rem}
.error{color:#dc2626;margin:8px 0 0;padding-left:18px}
.stat{background:#eff6ff;border-radius:10px;padding:14px;text-align:center}.stat strong{display:block;font-size:1.4rem;color:var(--p)}
.bar{background:var(--b);border-radius:20px;height:14px;overflow:hidden;margin:16px 0}
.bar div{height:100%;background:linear-gradient(90deg,#22c55e,#2563eb);transition:width .8s}
.steps{display:flex;justify-content:space-between;list-style:none;padding:0;gap:6px;font-size:.85rem;text-align:center}
.steps li{flex:1;color:var(--m)}.steps li.done{color:#16a34a;font-weight:700}
.badge{padding:3px 10px;border-radius:20px;background:#dbeafe;color:#1d4ed8;font-size:.8rem}
.footer{text-align:center;color:var(--m);padding:16px;font-size:.85rem}
.modal{position:fixed;inset:0;background:rgba(15,23,42,.55);display:none;align-items:center;justify-content:center;z-index:20;padding:16px}
.modal.show{display:flex}.modal-box{background:#fff;border-radius:12px;padding:22px;width:100%;max-width:420px;animation:pop .25s}
@keyframes pop{from{transform:scale(.9);opacity:0}to{transform:scale(1);opacity:1}}
@media(max-width:600px){.steps{font-size:.7rem}}
